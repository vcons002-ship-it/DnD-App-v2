# Copy to .env and adjust as needed.

# Port the local server listens on.
PORT=4000

# Public base URL that remote DM/players use to reach the app.
# Leave blank to auto-detect from a Cloudflare quick tunnel (cloudflared).
# Set explicitly if you use a named tunnel or a different tunnel provider.
PUBLIC_URL=

# Optional: name of a pre-created Cloudflare named tunnel for a stable hostname.
# If blank, a temporary trycloudflare.com quick tunnel is used.
CF_TUNNEL_NAME=

# Optional passphrase required to open the DM view (/dm). Leave blank to disable.
DM_PASSPHRASE=

# Gemini API key — only needed for AI creature creation (Phase 4+).
GEMINI_API_KEY=
