# Copy to .env and adjust as needed.

# Port the local server listens on.
PORT=4000

# Public base URL that remote DM/players use to reach the app.
# Leave blank to auto-detect from a Cloudflare quick tunnel (cloudflared).
# Set to your own hostname when using a named/token tunnel below (recommended
# for a stable link) — e.g. https://vtt.yourdomain.com
PUBLIC_URL=

# --- Put the app on YOUR OWN DOMAIN (stable link, no flaky quick tunnels) ---
# Easiest: create a tunnel in the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> Create), add a Public Hostname pointing at
# http://localhost:4000, copy the tunnel TOKEN here, and set PUBLIC_URL above to
# that hostname. cloudflared then runs with --token and the dashboard handles DNS.
CF_TUNNEL_TOKEN=

# Alternative: a locally-configured named tunnel (cloudflared reads its own
# ~/.cloudflared/config.yml ingress). Set PUBLIC_URL to its hostname.
CF_TUNNEL_NAME=

# Optional secret required to open the DM view (/dm). If blank, one is generated
# on first run and printed at startup / saved to server/data/dm-secret.txt.
DM_PASSPHRASE=

# Gemini API key — only needed for AI creature creation (Phase 4+).
GEMINI_API_KEY=

# Optional: pin a specific Gemini model. Leave blank to auto-pick a current one
# (the server tries gemini-flash-latest, gemini-2.5-flash, … and caches what works).
GEMINI_MODEL=
