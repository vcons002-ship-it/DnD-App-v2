# Windows scripts must use CRLF so batch labels/prompts work correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must keep LF.
*.sh text eol=lf

# package-lock.json is machine-generated and `npm install` rewrites it locally
# (npm normalizes it per version), so treat it as generated and, during a merge,
# keep our committed copy instead of trying to merge it — this prevents spurious
# lockfile conflicts on a manual `git pull`. (The installer's `reset --hard` is the
# primary guard; this covers people who pull by hand.) The `merge=ours` driver is
# enabled per-repo by install.bat / install.sh via `git config merge.ours.driver true`.
package-lock.json merge=ours linguist-generated=true

# Accepted high-detail miniature review assets, not client runtime payloads.
assets/miniatures/models/*.glb filter=lfs diff=lfs merge=lfs -text

# Reviewed full-detail models with lossless delivery compression.
client/public/miniatures/*.glb filter=lfs diff=lfs merge=lfs -text
client/public/miniatures/*.json -filter diff merge -text whitespace=cr-at-eol

# Immutable selected evidence: preserve every recorded payload byte, including
# JSON receipts and prompt files, without Windows line-ending normalization.
assets/miniatures/runtime-provenance/** filter=lfs diff=lfs merge=lfs -text
# Keep the archive inventory directly reviewable in Git, still byte-preserved.
assets/miniatures/runtime-provenance/manifest.json -filter diff merge -text whitespace=cr-at-eol
